// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SOURCE_MANAGER
  VIEWER
}

model User {
  id                    String          @id @default(uuid())
  email                 String          @unique
  password              String
  firstName             String?
  lastName              String?
  role                  Role            @default(VIEWER)
  isActive              Boolean         @default(true)
  dataProcessingConsent Boolean         @default(false) // GDPR consent
  consentDate           DateTime?       // When consent was given
  dataRetentionDays     Int             @default(365)   // How long to retain data
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  imagingSources        ImagingSource[]
  accessGrants          AccessGrant[]

  @@map("users")
}

model ImagingSource {
  id             String        @id @default(uuid())
  name           String
  description    String?
  datastoreId    String
  region         String
  encryptedCreds String        // Encrypted JSON containing AWS credentials
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  accessGrants   AccessGrant[]

  @@map("imaging_sources")
}

model AccessGrant {
  id              String        @id @default(uuid())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  imagingSource   ImagingSource @relation(fields: [imagingSourceId], references: [id], onDelete: Cascade)
  imagingSourceId String
  createdAt       DateTime      @default(now())

  @@unique([userId, imagingSourceId])
  @@map("access_grants")
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  USER_REGISTER
  USER_UPDATE
  USER_DELETE
  SOURCE_CREATE
  SOURCE_UPDATE
  SOURCE_DELETE
  SOURCE_ACCESS_GRANTED
  SOURCE_ACCESS_REVOKED
  STUDY_VIEW
  STUDY_EXPORT
  FRAME_ACCESS
  METADATA_ACCESS
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?     // Nullable for system events
  userEmail  String?     // Store email for reference even if user is deleted
  action     AuditAction
  resource   String?     // Resource identifier (e.g., studyId, sourceId)
  details    Json?       // Additional details about the action
  ipAddress  String?
  userAgent  String?
  success    Boolean     @default(true)
  errorMessage String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
